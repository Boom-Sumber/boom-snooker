# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
out/
release/
*.exe
*.msi
*.nsis.7z

# 注意：build/ 不忽略 —— 它是 electron-builder 的 buildResources（图标），必须入库

# 环境变量（含密钥，绝不入库）
.env.local
.env.*.local

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Electron / 缓存
.cache/
.electron/
.electron-vite/

# 本地缓存数据（运行时生成）
cache.json
*.bak
temp.json

# TypeScript
*.tsbuildinfo
.eslintcache

# AI 助手的本地记忆与临时文件（不是项目产物）
.workbuddy-ai/
.workbuddy/
